<Window x:Class="CyberNest_Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberNest_Admin"
        mc:Ignorable="d"
        Title="CyberNest Admin felület" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ThreeDBorderWindow"
        Background="#1E1E1E" Foreground="#007ACC">
    <Grid>
        <!--FIGYELEM! ÁLTALÁNOS TÁJÉKOZTATÓ ERRŐL AZ XAML FÁJLRÓL:
        1. Fontos panelek nevei és láthatósággal kapcsolatos beállításaik:
            - LoginPage: Ez a StackPanel tartalmazza a bejelentkezési űrlapot. Ez a panel kezdetben már látszik
            - SideBrand_loginPage: Ez a StackPanel tartalmazza a jobb oldali márkázási elemeket. 
            - MainContentPage: Ez a StackPanel tartalmazza a fő tartalmat, beleértve a menüt és egyéb adminisztrációs elemeket. Kezdetben rejtett, és csak akkor lesz látható, amikor a bejelentkezés sikeres volt.
        2.Színpaletta:
            - #1E1E1E  // háttér
            - #2D2D30  // panel
            - #3F3F46  // világos panel
            - #5A5A5F  // border
            - #007ACC  // primary
            - #1C97EA  // hover
            - #28A745  // success
            - #FFC107  // warning
            - #DC3545  // error
            - #F0F0F0  // text
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Background="#1E1E1E"
                    Grid.RowSpan="5" 
                    Grid.ColumnSpan="3"
                    Visibility="Hidden"/>


        <StackPanel x:Name="SideBrand_loginPage" 
                    Grid.Column="3"
                    Grid.RowSpan="5"
                    Visibility="Hidden">
            <StackPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF0C447D" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBlock TextWrapping="Wrap"
                           Foreground="#007ACC"
                           Text="CyberNest - Admin felület" 
                           FontSize="20"
                           Margin="0,213,0,-266"
                           Grid.Row="2"
                           FontWeight="Bold"
                           TextTrimming="WordEllipsis"
                           FontFamily="Corbel"
                           HorizontalAlignment="Center"
                           Width="132" FontStyle="Italic"/>


            </Grid>
        </StackPanel>
        <StackPanel x:Name="MainContentPage"
                    Grid.ColumnSpan="5"
                    Grid.RowSpan="5"
                    Visibility="Visible">

            <!--Ez csak akkor lesz látható ha a bejelentkezés sikeres volt.-->
            <Menu x:Name="TopMainMenu"
                  Height="21" 
                  Background="#2D2D30"
                  Foreground="#007ACC"
                  HorizontalAlignment="Stretch">

                <MenuItem x:Name="FelhasznalokMenu"
                         Header="Felhasználók" 
                          FontSize="14">
                    <MenuItem x:Name="FelhasznalokListajaMenu" Header="Felhasználók listája" Click="FelhasznalokListajaMenu_Click"/>
                    <MenuItem x:Name="UjFelhasznaloMenu" Header="Új felhasználó" Click="UjFelhasznaloMenu_Click"/>
                    <MenuItem x:Name="FelhasznaloTorleseMenu" Header="Felhasználó törlése" Click="FelhasznaloTorleseMenu_Click"/>
                    <MenuItem x:Name="FelhasznaloModositasMenu" Header="Felhasználó módosítása" Click="FelhasznaloModositasMenu_Click"/>
                </MenuItem>
                <MenuItem x:Name="EszkozokMenu"
                          Header="Eszközök" 
                          FontSize="14">
                    <MenuItem x:Name="EszkozokListajaMenu" Header="Eszközök listája" Click="EszkozokListajaMenu_Click"/>
                    <MenuItem x:Name="UjEszkozMenu" Header="Új eszköz" Click="UjEszkozMenu_Click"/>
                    <MenuItem x:Name="EszkozTorleseMenu" Header="Eszköz törlése" Click="EszkozTorleseMenu_Click"/>
                    <MenuItem x:Name="EszkozModositasMenu" Header="Eszköz módosítása" Click="EszkozModositasMenu_Click"/>
                </MenuItem>
                <MenuItem x:Name="UzemeltetokMenu"
                          Header="Üzemeltetők"
                          FontSize="14">
                    <MenuItem x:Name="UzemeltetokListajaMenu" Header="Üzemeltetők listája" Click="UzemeltetokListajaMenu_Click"/>
                    <MenuItem x:Name="UjUzemeltetoMenu" Header="Új üzemeltető" Click="UjUzemeltetoMenu_Click"/>
                    <MenuItem x:Name="UzemeltetoModositasMenu" Header="Üzemeltető módosítása" Click="UzemeltetoModositasMenu_Click"/>
                    <MenuItem x:Name="UzemeltetoTorleseMenu" Header="Üzemeltető törlése" Click="UzemeltetoTorleseMenu_Click"/>
                </MenuItem>
                <MenuItem x:Name="FoglalasMenu"
                          Header="Foglalás"
                          FontSize="14">
                    <MenuItem x:Name="FoglalasListajaMenu" Header="Foglalás listája" Click="FoglalasListajaMenu_Click"/>
                    <MenuItem x:Name="FoglalasTorleseMenu" Header="Foglalás törlése" Click="FoglalasTorleseMenu_Click"/>

                </MenuItem>
                <MenuItem x:Name="ErtekelesekMenu"
                          Header="Értékelések"
                          FontSize="14">
                    <MenuItem x:Name="ErtekelesekListaMenu" Header="Értékelések Listázása" Click="ErtekelesekMenu_Click" />
                    <MenuItem x:Name="ErtekelesTorleseMenu" Header="Értékelés törlése" Click="ErtekelesTorleseMenu_Click"/>
                    <MenuItem x:Name="ErtekelesModositasMenu" Header="Értékelés módosítása" Click="ErtekelesModositasMenu_Click"/>
                    <MenuItem x:Name="UjErtekelesMenu" Header="Új értékelés" Click="UjErtekelesMenu_Click"/>
                </MenuItem>
                <MenuItem x:Name="NaplozasMenu" 
                          Header="Naplózás"
                          FontSize="14">
                    <MenuItem x:Name="NaplozasListajaMenu" Header="Naplózás listája" Click="NaplozasListajaMenu_Click"/>
                    <MenuItem x:Name="NaplozasTorleseMenu" Header="Naplózás törlése" Click="NaplozasTorleseMenu_Click"/>
                    <MenuItem x:Name="NaplozasModositasMenu" Header="Naplózás módosítása" Click="NaplozasModositasMenu_Click"/>
                    <MenuItem x:Name="UjNaplozasMenu" Header="Új naplózás" Click="UjNaplozasMenu_Click"/>
                </MenuItem>
                <MenuItem x:Name="kijelentkezesMenu" 
                          Header="kijelentkezés"
                          FontSize="14"
                          Click="kijelentkezesMenu_Click"/>

            </Menu>

            <Grid Height="412" Width="799" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="WelocmePage"
                            Background="#3F3F46"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Grid.Row="2"
                            Grid.RowSpan="2"
                            Visibility="Hidden">
                    <TextBlock x:Name="WelocmeTextblock"
                               TextWrapping="Wrap" 
                               Text="Üdvözlünk, "
                               FontSize="23" FontFamily="Cascadia Mono SemiBold"/>

                </StackPanel>
                <!-- Felhasznalok listázás -->
                <StackPanel x:Name="FelhasznaloListPanel"
                            Background="#3F3F46"
                            Margin="0,66,0,10"
                            Grid.Column="1"
                            Grid.RowSpan="4"
                            Grid.ColumnSpan="2"
                            Visibility="Hidden">
                    <Button x:Name="FelhasznalokListBackBtn" Content="Vissza" Width="84" Click="FelhasznalokListBackBtn_Click"/>
                    <ListView x:Name="FelhasznalokListView">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Név" DisplayMemberBinding="{Binding Nev}" Width="150"/>
                                <GridViewColumn Header="E-mail" DisplayMemberBinding="{Binding Elerhetoseg}" Width="200"/>
                                <GridViewColumn Header="Szerepkör" DisplayMemberBinding="{Binding Role}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
                <!-- Új felhasználó létrehozása -->
                <StackPanel x:Name="UjFelhasznaloPanel"
                            Background="#3F3F46"
                            Margin="0,29,0,46"
                            Grid.Column="1"
                            Grid.RowSpan="5"
                            Grid.ColumnSpan="2"
                            Visibility="Hidden">
                    <Grid Height="246">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="UjFelhasznaloBackBtn" Content="Vissza" Width="84" RenderTransformOrigin="0.452,0.754" Margin="20,111,29,-82" Grid.Row="4"/>
                        <TextBlock Text="Név:" Margin="10,10,10,10" Grid.Row="2"/>
                        <TextBox x:Name="UjFelhasznaloNev" Margin="10,10,10,10" Grid.Column="1" Grid.Row="2"/>
                        <TextBlock Text="E-mail:" Margin="10,10,10,10" Grid.Row="1"/>
                        <TextBox x:Name="UjFelhasznaloEmail" Margin="10,10,10,10" Grid.Column="1" Grid.Row="1"/>
                        <TextBlock Text="Admin:" Margin="10,10,10,10" Grid.Row="3"/>
                        <Button x:Name="UjFelhasznaloSaveBtn" Content="Mentés" Width="84" Margin="24,111,25,-82" Click="UjFelhasznaloSaveBtn_Click" Grid.Column="2" Grid.Row="4"/>
                        <CheckBox x:Name="ujFelhasznaloCheckBox" Grid.Column="1" HorizontalAlignment="Left" Foreground="#007ACC" Margin="104,0,0,0" Grid.Row="3" VerticalAlignment="Center" Width="20" Height="19"/>
                    </Grid>


                </StackPanel>
                <!-- Felhasználók törlése -->
                <StackPanel x:Name="FelhasznaloTorlesPanel"
                         Background="#3F3F46"
                         Margin="0,66,0,10"
                         Grid.Column="1"
                         Grid.RowSpan="4"
                         Grid.ColumnSpan="2"
                         Visibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Válassza ki a törölni kívánt felhasználót:" Margin="10,10,10,10" Grid.ColumnSpan="2"/>
                        <ComboBox x:Name="FelhasznaloTorlesComboBox" Margin="10,3,10,3" Grid.Row="2" RenderTransformOrigin="0.5,0.5" Grid.Column="1"/>

                        <Button x:Name="FelhasznaloTorlesSaveBtn"
                                Content="Mentés"
                                Width="84"
                                Margin="39,183,10,-180"
                                Click="FelhasznaloTorlesSaveBtn_Click"
                                Grid.Column="2" 
                                Grid.Row="1" 
                                Grid.RowSpan="2"/>
                        <Button x:Name="FelhasznalokTorlesVisszaBtn"
                                Content="Vissza"
                                Width="84"
                                Margin="10,183,39,-180" 
                                Click="FelhasznalokTorlesVisszaBtn_Click" 
                                Grid.Row="1" 
                                Grid.RowSpan="2"/>

                    </Grid>


                </StackPanel>
                <!-- Felhasználók módosítása -->
                <StackPanel x:Name="FelhasznaloModositasPanel"
                            Background="#3F3F46"
                            Margin="0,29,0,46"
                            Grid.Column="1"
                            Grid.RowSpan="5"
                            Grid.ColumnSpan="2"
                            Visibility="Hidden">
                    <Grid Height="246">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="FelhasznaloModositasBackBtn" Content="Vissza" Width="84" RenderTransformOrigin="0.452,0.754" Margin="20,111,29,-82" Grid.Row="4" Click="FelhasznaloModositasBackBtn_Click"/>
                        <TextBlock Text="Név:" Margin="10,10,10,10" Grid.Row="2"/>
                        <TextBox x:Name="modFelhasznaloNev" Margin="10,10,10,10" Grid.Column="1" Grid.Row="2"/>
                        <TextBlock Text="E-mail:" Margin="10,10,10,10" Grid.Row="1"/>
                        <TextBox x:Name="modFelhasznaloEmail" Margin="10,10,10,10" Grid.Column="1" Grid.Row="1"/>
                        <TextBlock Text="Jogosultság:" Margin="10,10,10,10" Grid.Row="3"/>
                        <ComboBox x:Name="modFelhasznaloJogosultsag" Grid.Column="1" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" Width="114"/>
                        <Button x:Name="FelhasznaloModositasSaveBtn" Content="Mentés" Width="84" Margin="24,111,25,-82" Click="FelhasznaloModositasSaveBtn_Click" Grid.Column="2" Grid.Row="4"/>
                        <!--<CheckBox x:Name="modFelhasznaloCheckBox" Grid.Column="1" HorizontalAlignment="Left" Foreground="#007ACC" Margin="104,0,0,0" Grid.Row="3" VerticalAlignment="Center" Width="20" Height="19"/>-->

                        <ComboBox x:Name="modFelhasznaloComboBox" Grid.Column="2" Margin="52,6,10,6" SelectionChanged="modFelhasznaloComboBox_SelectionChanged" />
                        <TextBlock TextWrapping="Wrap" Text="Felhasználó:" Margin="3,5,81,6" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
                <!-- Eszkozok list -->
                <StackPanel x:Name="EszkozokListPanel"
                            Grid.Column="0"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Left"
                            Background="#3F3F46" 
                            Margin="0,82,0,0" 
                            Width="590"
                            Visibility="Hidden">
                    <Button x:Name="EszkozokListBackBtn" Content="Vissza" Width="84" Click="EszkozokListBackBtn_Click"/>
                    <ListView x:Name="EszkozokListView" 
                              Height="146" >
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="20"/>
                                <GridViewColumn Header="leírás" DisplayMemberBinding="{Binding Leiras}" Width="100"/>
                                <GridViewColumn Header="CPU" DisplayMemberBinding="{Binding Cpu}" Width="100"/>
                                <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding Ram}" Width="100"/>
                                <GridViewColumn Header="HDD" DisplayMemberBinding="{Binding Hdd}" Width="100"/>
                                <GridViewColumn Header="uzemelteto_nev" DisplayMemberBinding="{Binding UzemeltetoNev}" Width="180"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </StackPanel>
                <!-- Új eszköz hozzáadása -->
                <StackPanel x:Name="ujEszkozPanel"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="4"
                            Background="#3F3F46" Margin="0,82,0,82"
                            Visibility="Hidden">
                    <Grid Height="165">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="0" TextWrapping="Wrap" Text="Leírás" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="CPU" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="RAM" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="HDD" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="4" TextWrapping="Wrap" Text="Üzemeltető neve" VerticalAlignment="Center"/>


                        <TextBox x:Name="ujEszkozRam" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114" Grid.Row="2"/>
                        <TextBox x:Name="ujEszkozCpu" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114" Grid.Row="1"/>
                        <TextBox x:Name="ujEszkozHdd" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114" Grid.Row="3"/>
                        <TextBox x:Name="ujEszkozLeiras" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114"/>

                        <ComboBox x:Name="ujEszkozUzemelteto" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Width="114" Grid.Row="4"/>

                        <Button x:Name="ujEszkozSaveBtn" Content="Mentés" Width="84" Margin="25,4,25,5" Grid.Row="5" Grid.Column="1" Click="ujEszkozSaveBtn_Click"/>
                        <Button x:Name="ujEszkozBackBtn" Content="Vissza" Width="84" Margin="17,4,32,5" Grid.Row="5" Grid.Column="0" Click="ujEszkozBackBtn_Click"/>
                    </Grid>


                </StackPanel>
                <!-- Eszköz törlése -->
                <StackPanel x:Name="EszkozTorlesPanel"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="3"
                            Background="#3F3F46" Margin="0,82,0,82"
                            Visibility="Hidden">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Válassza ki a törölni kívánt eszközt:" Margin="10,10,10,10" Grid.ColumnSpan="2"/>
                        <ComboBox x:Name="EszkozTorlesComboBox" Margin="10,3,10,3" Grid.Row="2" RenderTransformOrigin="0.5,0.5" Grid.Column="1"/>
                        <!--Vissza gomb és Mentés-->
                        <Button x:Name="EszkozTorlesVisszaBtn" 
                                Margin="10,3,10,3"
                                Grid.Row="2"
                                Content="Vissza"
                                Click="EszkozTorlesVisszaBtn_Click"/>
                        <Button x:Name="EszkozTorlesSaveBtn"
                                Content="Mentés"
                                Click="EszkozTorlesSaveBtn_Click"
                                Grid.Column="2" Margin="8,3,41,3" Grid.Row="2"
                            />
                    </Grid>
                </StackPanel>
                <!-- Eszköz Módosítása -->
                <StackPanel x:Name="EszkozModositasPanel"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Grid.RowSpan="5"
                             Background="#3F3F46" Margin="0,82,0,82"
                             Visibility="Hidden">
                    <Grid Height="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="0" TextWrapping="Wrap" Text="Leírás" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="1" TextWrapping="Wrap" Text="CPU" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="2" TextWrapping="Wrap" Text="RAM" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="3" TextWrapping="Wrap" Text="HDD" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Left" Margin="33,0,0,0" Grid.Row="4" TextWrapping="Wrap" Text="Üzemeltető neve" VerticalAlignment="Center"/>


                        <TextBox x:Name="modEszkozRam" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114" Grid.Row="2"/>
                        <TextBox x:Name="modEszkozCpu" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114" Grid.Row="1"/>
                        <TextBox x:Name="modEszkozHdd" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114" Grid.Row="3"/>
                        <TextBox x:Name="modEszkozLeiras" HorizontalAlignment="Center" Grid.Column="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="114"/>

                        <ComboBox x:Name="modEszkozUzemelteto" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Width="114" Grid.Row="4"/>

                        <Button x:Name="modEszkozSaveBtn" Content="Mentés" Width="84" Margin="25,4,25,5" Grid.Row="5" Grid.Column="1" Click="modEszkozSaveBtn_Click"/>
                        <Button x:Name="modEszkozBackBtn" Content="Vissza" Width="84" Margin="17,4,32,5" Grid.Row="5" Grid.Column="0" Click="modEszkozBackBtn_Click"/>
                        <ComboBox x:Name="modEszkozEszkComboBox" Grid.Column="2" Margin="52,6,10,27" Grid.RowSpan="2" SelectionChanged="modEszkozEszkComboBox_SelectionChanged" />
                        <TextBlock TextWrapping="Wrap" Text="Eszköz:" Margin="3,5,81,6" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
                <!-- Üzemeltetok listázás-->
                <StackPanel x:Name="UzemeltetoListPanel"
                            Background="#3F3F46"
                            Margin="0,66,0,10"
                            Grid.Column="1"
                            Grid.RowSpan="4"
                            Grid.ColumnSpan="2"
                            Visibility="Hidden">
                    <Button x:Name="UzemeltetokListBackBtn" Content="Vissza" Width="84" Click="UzemeltetokListBackBtn_Click"/>
                    <ListView x:Name="UzemeltetokListView" Width="402">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="25"/>
                                <GridViewColumn Header="Név" DisplayMemberBinding="{Binding Nev}" Width="150"/>
                                <GridViewColumn Header="Leírás" DisplayMemberBinding="{Binding Leiras}" Width="280"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
                <!-- Új üzemeltető hozzáadása -->
                <StackPanel x:Name="UjUzemeltetoPanel"
                            Background="#3F3F46"
                            Margin="0,46,0,46"
                            Grid.Column="1"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="2"
                            Visibility="Hidden" Grid.Row="1">
                    <Grid Height="143">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Név:" Margin="10,10,10,10" Grid.Row="0"/>
                        <TextBox x:Name="UjUzemeltetoNev" Margin="10,10,10,10" Grid.Column="1" Grid.Row="0"/>
                        <TextBlock Text="Leírás:" Margin="10,10,10,10" Grid.Row="1"/>
